PROCEDURE Main()

   LOCAL oLantern := Lantern():New()
   LOCAL oCompass := Compass():New()

   oLantern:cInscription := "east wall"
   oCompass:cInscription := "magnetic north"

   OutStd( oLantern:cInscription )

   oLantern:Engrave()
   oCompass:Engrave()

   RETURN
